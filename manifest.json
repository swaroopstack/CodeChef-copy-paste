{
  "manifest_version": 3,
  "name": "CodeChef Clipboard Unlocker",
  "version": "1.1.8",
  "description": "Restores copy, cut, paste, select-all and drag-and-drop inside CodeChef's code editor.",
  "minimum_chrome_version": "111",
  "permissions": ["clipboardRead", "clipboardWrite"],
  "host_permissions": ["*://codechef.com/*", "*://*.codechef.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://codechef.com/*", "*://*.codechef.com/*"],
      "js": ["content-main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["*://codechef.com/*", "*://*.codechef.com/*"],
      "js": ["content-isolated.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
